[submodule "linux"]
	path = linux
	url = https://github.com/torvalds/linux
	branch = master
[submodule "gobox"]
	path = gobox
	url = https://github.com/segfaultuwu/gobox
	branch = main
[submodule "limine"]
	path = limine
	url = https://github.com/limine-bootloader/limine.git
	branch = v11.x-binary
[submodule "third_party/curl"]
	path = third_party/curl
	url = https://github.com/curl/curl.git
[submodule "third_party/dropbear"]
	path = third_party/dropbear
	url = https://github.com/mkj/dropbear.git
[submodule "third_party/bash"]
	path = third_party/bash
	url = https://github.com/gitGNU/gnu_bash
[submodule "third_party/git"]
	path = third_party/git
	url = https://github.com/git/git.git
